PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_system
DB_POOL_MAX=10
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Phase 7: path to the compiled C++ engine binary. Leave unset to use the
# default (<project root>/engine/build/trading_engine). Override if your
# build output lands somewhere else.
# ENGINE_BINARY_PATH=
ENGINE_TIMEOUT_MS=5000

# Phase 8: "live" (default) tries Yahoo Finance first, falls back to mock
# data on any failure. Set to "mock" to skip the live fetch entirely
# (useful offline or in CI). See docs/MARKET_DATA_SOURCE.md.
MARKET_DATA_PROVIDER=live

# Phase 9: live WebSocket feed tick/heartbeat intervals.
WS_TICK_INTERVAL_MS=15000
WS_HEARTBEAT_INTERVAL_MS=30000

# Phase 11
DEMO_BACKTEST_FILE=data/demo_backtest_nifty_5m.csv
PAPER_TRADING_ENABLED=false

# Telegram alerts for BUY / SELL notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
